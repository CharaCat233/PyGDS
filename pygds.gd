	## MT19937 的 32 位生成 (D1 对齐 CPython Mersenne Twister): [br]
	## 状态 624 字, 每 624 次输出后整表 twist, tempering 后输出
	func _mt_genrand() -> int:
		if _mt_index >= 624:
			_mt_twist()
		var y = _mt_state[_mt_index]
		y = y ^ (y >> 11)
		y = y ^ ((y << 7) & 0x9D2C5680)
		y = y ^ ((y << 15) & 0xEFC60000)
		y = y ^ (y >> 18)
		_mt_index += 1
		return y & 0xFFFFFFFF

	func _mt_twist() -> void:
		for i in range(624):
			var y = (_mt_state[i] & 0x80000000) + (_mt_state[(i + 1) % 624] & 0x7FFFFFFF)
			var nxt = y >> 1
			if y % 2 == 1:
				nxt = nxt ^ 0x9908B0DF
			_mt_state[i] = _mt_state[(i + 397) % 624] ^ nxt
		_mt_index = 0

	## MT19937 的 init_genrand (int 种子, CPython random_seed 的 int 路径)
	func _mt_init_genrand(s: int) -> void:
		s = s & 0xFFFFFFFF
		_mt_state[0] = s
		for i in range(1, 624):
			s = (1812433253 * (s ^ (s >> 30)) + i) & 0xFFFFFFFF
			_mt_state[i] = s
		_mt_index = 624

	## MT19937 的 init_by_array (key 数组, 字符串种子经哈希展开后的整型键)
	func _mt_init_by_array(key: Array) -> void:
		_mt_init_genrand(19650218)
		var i = 1
		var j = 0
		var n = maxi(key.size(), 624)
		for _loop in range(n):
			var kj = key[j] & 0xFFFFFFFF
			_mt_state[i] = ((_mt_state[i] ^ ((_mt_state[i - 1] ^ (_mt_state[i - 1] >> 30)) * 1664525)) + kj + j) & 0xFFFFFFFF
			i += 1
			j += 1
			if i >= 624:
				_mt_state[0] = _mt_state[623]
				i = 1
			if j >= key.size():
				j = 0
		for _loop in range(623):
			_mt_state[i] = ((_mt_state[i] ^ ((_mt_state[i - 1] ^ (_mt_state[i - 1] >> 30)) * 1566083941)) - i) & 0xFFFFFFFF
			i += 1
			if i >= 624:
				_mt_state[0] = _mt_state[623]
				i = 1
		_mt_state[0] = 0x80000000
		_mt_index = 624

	## getrandbits(k) (CPython _randbits: 多字组合, 高字在前)
	func _mt_getrandbits(k: int) -> int:
		if k <= 0:
			return 0
		# CPython _randbits 语义: 低位字先, 最高字按剩余位数右移
		var words = (k - 1) >> 5
		var result = 0
		for w in range(words + 1):
			var r = _mt_genrand()
			if w == words:
				var shift = (words << 5) + 32 - k
				r = r >> shift if shift < 32 else 0
			result |= r << (w << 5)
		return result

	## random(): CPython 的 53 位双字组合
	func _rng_float() -> float:
		var a = _mt_genrand() >> 5
		var b = _mt_genrand() >> 6
		return (a * 67108864.0 + b) / 9007199254740992.0

	## _randbelow(n): CPython 的拒绝采样 (getrandbits 循环)
	func _rng_randbelow(n: int) -> int:
		if n <= 0:
			return 0
		# CPython _randbelow_with_getrandbits: k = n.bit_length() (拒绝采样)
		var k = 0
		var t = n
		while t > 0:
			k += 1
			t = t >> 1
		var r = _mt_getrandbits(k)
		while r >= n:
			r = _mt_getrandbits(k)
		return r


	## 从 DSLObject 参数中提取数值 [br]
	## [param arg] DSLInteger 或 DSLFloat [br]
	## [returns] 数值或 null
	func _num_val(arg: DSLObject):
		if arg is DSLInteger:
			return arg.value
		if arg is DSLFloat:
			return arg.value
		return null

	## 从 DSLObject 参数中提取数值, 不可用时返回默认值 [br]
	## [param arg] DSLObject 参数, 可为 null [br]
	## [param default] 默认值 [br]
	## [returns] 数值
	func _num_val_or(arg, default: float) -> float:
		if arg == null:
			return default
		var v = _num_val(arg)
		return default if v == null else float(v)

	## math.sqrt(x)
	func _math_sqrt(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		if args.size() != 1:
			raise_exception("TypeError", "sqrt() takes exactly one argument")
			return null
		var x = _num_val(args[0])
		if x == null:
			raise_exception("TypeError", "sqrt() argument must be a number")
			return null
		# 域错误: CPython 对负数报 ValueError (宿主 sqrt 给出 nan)
		if x < 0:
			raise_exception("ValueError", "math domain error")
			return null
		return DSLFloat.new(sqrt(float(x)))

	## math.isqrt(x)
	func _math_isqrt(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
