			return null
		var sub = args[1]._dsl_str()
		var sv = raw.value
		var si = 0
		var ei = sv.length()
		if args.size() >= 3 and args[2] is DSLInteger:
			si = args[2].value
			if si < 0:
				si = max(0, si + sv.length())
		if args.size() >= 4 and args[3] is DSLInteger:
			ei = args[3].value
			if ei < 0:
				ei = max(0, ei + sv.length())
			ei = min(ei, sv.length())
		sv = sv.substr(si, ei - si)
		var cnt = 0
		var pos = 0
		while true:
			pos = sv.find(sub, pos)
			if pos == -1:
				break
			cnt += 1
			pos += sub.length()
		return DSLInteger.pooled(cnt)
	
