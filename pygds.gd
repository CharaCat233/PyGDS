## sys.modules 活视图 (I1-32): 代理解释器模块表 (含 sys 自身)
class DSLSysModulesView extends DSLDict:
	## sys 模块对象 (视图归属)
	var sys_mod: DSLModule = null

	func _init(p_mod: DSLModule):
		super._init()
		sys_mod = p_mod

	func _ensure() -> void:
		dict.clear()
		var ip = Interpreter.active
		if ip == null:
			return
		for mk in ip.modules:
			var kv: Variant = "s:" + mk
			dict[kv] = ip.modules[mk]
		var kv_sys: Variant = "s:sys"
		dict[kv_sys] = sys_mod

	func _dsl_getitem(index: DSLObject) -> DSLObject:
		_ensure()
		return super._dsl_getitem(index)

	func magic_contains(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var target = DSLObject._unwrap_dsl(args[1])
		if not (target is DSLString):
			return DSLBool.new(false)
		var name = (target as DSLString).value
		return DSLBool.new(name == "sys" or Interpreter.active.modules.has(name))

	func magic_len(_args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		_ensure()
		return DSLInteger.pooled(dict.size())

	func _dsl_str() -> String:
		_ensure()
		return super._dsl_str()

	func magic_repr(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		_ensure()
		return super.magic_repr(args, _kwargs)

	func _dsl_iter() -> DSLIterator:
		_ensure()
		return DSLDictKeyIterator.new(self)

## globals() 的活视图: 读写字节代理到全局环境 (CPython 的 globals() 活字典语义)
class DSLGlobalsView extends DSLDict:
	## 代理的全局环境
	var env: DSLEnvironment = null

	func _init(p_env: DSLEnvironment):
		super._init()
		env = p_env

	func _sync_in() -> void:
		dict.clear()
		for k in env.values:
			# 键按 DSLDict 的字符串编码约定 (与 _key_to_variant 的 "s:" 前缀一致)
			var kv: Variant = "s:" + k
			dict[kv] = env.values[k]

	func _dsl_getitem(index: DSLObject) -> DSLObject:
		var target = DSLObject._unwrap_dsl(index)
		if not (target is DSLString):
			last_error = "KeyError: %s" % DSLObject._py_repr(index)
			return null
		var k = (target as DSLString).value
		if not env.values.has(k):
			last_error = "KeyError: %s" % DSLObject._py_repr(index)
			return null
		return env.values[k]

	func _dsl_setitem(index: DSLObject, value: DSLObject) -> void:
		if not (index is DSLString):
			last_error = "TypeError: keys must be str, not '%s'" % index._type_name()
			return
		env.values[(index as DSLString).value] = value

	func _dsl_delitem(index: DSLObject) -> void:
		var k = index._key_to_string()
		if not env.values.has(k):
			last_error = "KeyError: %s" % DSLObject._py_repr(index)
			return
		env.values.erase(k)

	func magic_len(_args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		return DSLInteger.pooled(env.values.size())

	func magic_contains(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var target = DSLObject._unwrap_dsl(args[1])
		if target is DSLString:
			return DSLBool.new(env.values.has((target as DSLString).value))
		return DSLBool.new(false)

	func _dsl_iter() -> DSLIterator:
		_sync_in()
		return DSLDictKeyIterator.new(self)

	func magic_keys(_args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var keys: Array[DSLObject] = []
		for k in env.values:
			keys.append(DSLString.new(k))
		return DSLDictKeys.new(keys)

	func magic_values(_args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var vals: Array[DSLObject] = []
		for k in env.values:
			vals.append(env.values[k])
		return DSLDictValues.new(vals)

	func magic_items(_args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var items: Array[DSLObject] = []
		for k in env.values:
			items.append(DSLTuple.new([DSLString.new(k), env.values[k]] as Array[DSLObject]))
		return DSLDictItems.new(items)

	func _dsl_str() -> String:
		_sync_in()
		return super._dsl_str()

	func magic_repr(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		_sync_in()
		return super.magic_repr(args, _kwargs)

	func magic_eq(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLBool:
		_sync_in()
		return super.magic_eq(args, _kwargs)


## DSL 文件对象, 对应 Python open() 的返回值 (P1-32) [br]
## 文本/二进制两态; 路径语义随宿主 FileAccess (相对路径按工程根解析); [br]
## 迭代产出按换行保留的行; 二进制读为 bytes, 写仅接受 bytes
class DSLFile extends DSLObject:
	## 底层 FileAccess 实例
	var _fa: FileAccess = null
	## 文件路径 (原样保留)
	var fpath: String = ""
	## 打开模式 (r/w/a/rb/wb/ab)
	var fmode: String = "r"
	## 二进制标记
	var binary: bool = false
	## 是否已关闭
	var is_closed: bool = false
	## 文本读缓冲 (惰性加载) 与读游标
	var _text_buf: String = ""
	var _text_buf_loaded: bool = false
	var _text_pos: int = 0

	## 构造文件对象
	## [param p_fa] 已打开的 FileAccess [br]
	## [param p_path] 路径 [br]
	## [param p_mode] 模式
	func _init(p_fa: FileAccess, p_path: String, p_mode: String):
		super._init()
		_fa = p_fa
		fpath = p_path
		fmode = p_mode
		binary = fmode.ends_with("b")

	func _type_name() -> String:
		return "BufferedReader" if binary else "TextIOWrapper"

	## 文件操作错误的统一抛出 (内建直接抛, 走 Interpreter.active)
	func _raise(err: String) -> void:
		if Interpreter.active != null:
			Interpreter.active.raise_exception_from_last_error(err)

	## 是否处于可读模式 (r 系)
	func _is_readable() -> bool:
		return fmode.begins_with("r")

	## 是否处于可写模式 (w/a 系)
	func _is_writable() -> bool:
		return fmode.begins_with("w") or fmode.begins_with("a")

	## 已关闭/读写权限统一校验, 失败时报错并返回 false
	func _check(need_read: bool, need_write: bool) -> bool:
		if is_closed:
			_raise("ValueError: I/O operation on closed file.")
			return false
		if need_read and not _is_readable():
			_raise("UnsupportedOperation: not readable")
			return false
		if need_write and not _is_writable():
			_raise("UnsupportedOperation: write")
			return false
		return true

	## 惰性加载文本读缓冲
	func _ensure_text_buf() -> void:
		if not _text_buf_loaded:
			_text_buf = _fa.get_as_text()
			_text_buf_loaded = true

	## 文本读: 读缓冲按游标取剩余/定长
	func _read_text(size: int) -> String:
		_ensure_text_buf()
		var rest = _text_buf.length() - _text_pos
		var n = rest if size < 0 else mini(size, rest)
		var out = _text_buf.substr(_text_pos, n)
		_text_pos += n
		return out

	## 二进制读: 读剩余全部字节 (eof_reached 在读越过末尾后置位, 以长度为准)
	func _read_all_bytes() -> Array[int]:
		var out: Array[int] = []
		while _fa.get_position() < _fa.get_length():
			out.append(_fa.get_8())
		return out

	## open() 语义的行迭代器 (按换行分行, 行尾保留; 二进制产出 bytes)
	func _line_iter() -> DSLIterator:
		var lines: Array[DSLObject] = []
		if binary:
			var data = _read_all_bytes()
			var cur: Array[int] = []
			for b in data:
				cur.append(b)
				if b == 10:
					lines.append(DSLBytes.new(cur))
					cur = []
			if not cur.is_empty():
				lines.append(DSLBytes.new(cur))
		else:
			_ensure_text_buf()
			var rest = _text_buf.substr(_text_pos)
			var pos = 0
			while pos < rest.length():
				var nl = rest.find("\n", pos)
				if nl == -1:
					lines.append(DSLString.new(rest.substr(pos)))
					pos = rest.length()
				else:
					lines.append(DSLString.new(rest.substr(pos, nl - pos + 1)))
					pos = nl + 1
			_text_pos = _text_buf.length()
		return DSLListIterator.new(lines)

	func _dsl_iter() -> DSLIterator:
		if not _check(true, false):
			return null
		return _line_iter()

	## 属性与方法统一分派
	func _dsl_getattribute(name: String) -> DSLObject:
		if name == "closed":
			return DSLBool.new(is_closed)
		if name == "name":
			return DSLString.new(fpath)
		if name == "mode":
			return DSLString.new(fmode)
		var methods = {
			"read": DSLWrappedDescriptor.new("read", Callable(self, "builtin_fread")),
			"readline": DSLWrappedDescriptor.new("readline", Callable(self, "builtin_freadline")),
			"readlines": DSLWrappedDescriptor.new("readlines", Callable(self, "builtin_freadlines")),
			"write": DSLWrappedDescriptor.new("write", Callable(self, "builtin_fwrite")),
			"writelines": DSLWrappedDescriptor.new("writelines", Callable(self, "builtin_fwritelines")),
			"close": DSLWrappedDescriptor.new("close", Callable(self, "builtin_fclose")),
			"seek": DSLWrappedDescriptor.new("seek", Callable(self, "builtin_fseek")),
			"tell": DSLWrappedDescriptor.new("tell", Callable(self, "builtin_ftell")),
			"flush": DSLWrappedDescriptor.new("flush", Callable(self, "builtin_fflush")),
			"readable": DSLWrappedDescriptor.new("readable", Callable(self, "builtin_freadable")),
			"writable": DSLWrappedDescriptor.new("writable", Callable(self, "builtin_fwritable")),
			"__enter__": DSLWrappedDescriptor.new("__enter__", Callable(self, "builtin_fenter")),
			"__exit__": DSLWrappedDescriptor.new("__exit__", Callable(self, "builtin_fexit")),
		}
		if methods.has(name):
			return methods[name].__get__(self, null)
		return super._dsl_getattribute(name)

	## read([size])
	func builtin_fread(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLFile
		if not self_obj._check(true, false):
			return null
		var size = -1
		if args.size() >= 2:
			var s_obj = DSLObject._unwrap_dsl(args[1])
			if not (s_obj is DSLInteger):
				self_obj._raise("TypeError: an integer is required")
				return null
			size = s_obj.value
		if size == 0:
			return DSLString.new("") if not self_obj.binary else DSLBytes.new([])
		if self_obj.binary:
			var data = self_obj._read_all_bytes()
			if size >= 0 and size < data.size():
				data = data.slice(0, size)
			return DSLBytes.new(data)
		return DSLString.new(self_obj._read_text(size))

	## readline(): 读一行 (含行尾), 文件尾返回空
	func builtin_freadline(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLFile
		if not self_obj._check(true, false):
			return null
		self_obj._ensure_text_buf()
		var rest = self_obj._text_buf.substr(self_obj._text_pos)
		if rest == "":
			return DSLString.new("")
		var nl = rest.find("\n")
		var take = rest.length() if nl == -1 else nl + 1
		self_obj._text_pos += take
		return DSLString.new(rest.substr(0, take))

	## readlines(): 全部行
	func builtin_freadlines(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLFile
		if not self_obj._check(true, false):
			return null
		var it = self_obj._line_iter()
		var items: Array[DSLObject] = []
		while it.has_next():
			items.append(it.next())
		return DSLList.new(items)

	## write(x): 文本写 str 返回字符数, 二进制写 bytes 返回字节数
	func builtin_fwrite(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLFile
		if not self_obj._check(false, true):
			return null
		var val = DSLObject._unwrap_dsl(args[1])
		if self_obj.binary:
			if not (val is DSLBytes):
				self_obj._raise("TypeError: a bytes-like object is required, not '%s'" % val._type_name())
				return null
			for b in val.data:
				self_obj._fa.store_8(b)
			self_obj._fa.flush()
			return DSLInteger.pooled(val.data.size())
		if not (val is DSLString):
			self_obj._raise("TypeError: write() argument must be str, not %s" % val._type_name())
			return null
		self_obj._fa.store_string(val.value)
		self_obj._fa.flush()
		return DSLInteger.pooled(val.value.length())

	## writelines(list): 逐项写入 (不加分隔)
	func builtin_fwritelines(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLFile
		if not self_obj._check(false, true):
			return null
		var seq = DSLObject._unwrap_dsl(args[1])
		if not (seq is DSLList or seq is DSLTuple):
			self_obj._raise("TypeError: '%s' object is not iterable" % seq._type_name())
			return null
		var count = 0
		for it in seq.items:
			var v = DSLObject._unwrap_dsl(it)
			if self_obj.binary:
				if not (v is DSLBytes):
					self_obj._raise("TypeError: a bytes-like object is required, not '%s'" % v._type_name())
					return null
				for b in v.data:
					self_obj._fa.store_8(b)
				count += v.data.size()
			else:
				if not (v is DSLString):
					self_obj._raise("TypeError: write() argument must be str, not %s" % v._type_name())
					return null
				self_obj._fa.store_string(v.value)
				count += v.value.length()
		self_obj._fa.flush()
		return DSLInteger.pooled(count)

	## readable()/writable()
	func builtin_freadable(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		return DSLBool.new((args[0] as DSLFile)._is_readable())

	func builtin_fwritable(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		return DSLBool.new((args[0] as DSLFile)._is_writable())

	## close(): 幂等
	func builtin_fclose(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLFile
		if self_obj._fa != null:
			self_obj._fa.close()
		self_obj.is_closed = true
		return DSLNone.new()

	## __enter__ 协议 (with 语句入口): 返回自身, with ... as f 即绑定文件对象
	func builtin_fenter(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		return args[0]

	## __exit__ 协议 (with 语句出口): 关闭文件并返回 None (不抑制 with 体异常), 重复退出幂等
	func builtin_fexit(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLFile
		if not self_obj.is_closed:
			if self_obj._fa != null:
				self_obj._fa.close()
			self_obj.is_closed = true
		return DSLNone.new()

	## seek(offset, whence=0): 文本模式基于缓冲游标, 二进制基于 FileAccess
	func builtin_fseek(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLFile
		if not self_obj._check(true, false):
			return null
		var off = DSLObject._unwrap_dsl(args[1])
		if not (off is DSLInteger):
			self_obj._raise("TypeError: an integer is required")
			return null
		var whence = 0
		if args.size() >= 3:
			var w_obj = DSLObject._unwrap_dsl(args[2])
			if not (w_obj is DSLInteger):
				self_obj._raise("TypeError: an integer is required")
				return null
			whence = w_obj.value
		if self_obj.binary:
			var target = off.value
			if whence == 1:
				target = self_obj._fa.get_position() + off.value
			elif whence == 2:
				target = self_obj._fa.get_length() + off.value
			self_obj._fa.seek(target)
			return DSLInteger.pooled(self_obj._fa.get_position())
		self_obj._ensure_text_buf()
		var pos = off.value
		if whence == 1:
			pos = self_obj._text_pos + off.value
		elif whence == 2:
			pos = self_obj._text_buf.length() + off.value
		self_obj._text_pos = clampi(pos, 0, self_obj._text_buf.length())
		return DSLInteger.pooled(self_obj._text_pos)

	## tell()
	func builtin_ftell(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLFile
		if not self_obj._check(true, false):
			return null
		if self_obj.binary:
			return DSLInteger.pooled(self_obj._fa.get_position())
		self_obj._ensure_text_buf()
		return DSLInteger.pooled(self_obj._text_pos)

	## flush(): 二进制写即落盘; 文本写同样即时落盘, 此处幂等
	func builtin_fflush(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLFile
		if not self_obj._check(false, false):
			return null
		if self_obj._fa != null:
			self_obj._fa.flush()
		return DSLNone.new()

class DSLBytesIterator extends DSLIterator:
	## 所属 bytes
	var src: DSLBytes = null
	## 当前位置
	var index: int = 0

	func _init(b: DSLBytes):
		super._init()
		src = b

	func has_next() -> bool:
		return index < src.data.size()

	func next() -> DSLObject:
		if index >= src.data.size():
			return null
		var v = src.data[index]
		index += 1
		return DSLInteger.pooled(v)

## DSL 集合类型, 对应 Python set [br]
## 元素为可哈希对象 (int/float/str/bool/None/tuple), 通过规范化键保证唯一性 [br]
## 支持集合运算 (| & - ^), 比较 (== != < <= > >=) 与常用方法
class DSLSet extends DSLObject:
	## 规范化键 -> DSLObject 映射
	var items: Dictionary = {}

	func _type_name() -> String:
		return "set"

	## 计算元素的规范化键, 不可哈希返回空字符串 [br]
	## [param obj] 元素对象 [br]
	## [returns] 规范化键, 不可哈希返回 ""
	func _set_key(obj: DSLObject) -> String:
		obj = DSLObject._unwrap_dsl(obj)
		# 数值键统一规范化: CPython 中 True == 1 == 1.0 是同一个集合元素,
		# 故 bool 与「取值为整数的 float」都按整数编键, 避免同一元素被重复收录
		if obj is DSLBool:
			return "i:" + ("1" if obj.value else "0")
		if obj is DSLInteger:
			# P0-13: 大数键编码为 "i:十进制串"
			if (obj as DSLInteger).is_big():
				return "i:" + DSLObject._int_dec_of(obj)
			return "i:" + str(obj.value)
		if obj is DSLFloat:
			if not is_nan(obj.value) and not is_inf(obj.value) and obj.value == floor(obj.value):
				if abs(obj.value) >= 9223372036854775808.0:
					return "i:" + DSLObject._int_dec_of(DSLObject._int_from_float_exact(obj.value))
				return "i:" + str(int(obj.value))
			return "f:" + str(obj.value)
		if obj is DSLComplex:
			# 复数键: 虚部为 0 时规范化为实部 (1+0j 与 1 同元素, CPython 一致)
			if obj.imag == 0.0 and not is_nan(obj.real) and not is_inf(obj.real) and obj.real == floor(obj.real):
				return "i:" + str(int(obj.real))
			if obj.imag == 0.0:
				return "f:" + str(obj.real)
			return "c:" + DSLObject._py_float_repr(obj.real) + "|" + DSLObject._py_float_repr(obj.imag)
		if obj is DSLNone:
			return "n"
		if obj is DSLString:
			return "s:" + obj.value
		if obj is DSLTuple:
			var parts = []
			for it in obj.items:
				var k = _set_key(it)
				if k == "":
					return ""
				parts.append(k)
			return "t:(" + ",".join(parts) + ")"
		if obj is DSLFrozenSet:
			var parts = []
			for k in obj.items:
				parts.append(k)
			parts.sort()
			return "fs:[" + ",".join(parts) + "]"
		if obj.klass != null:
			# 用户类实例: 需定义 __hash__ 才可作集合元素
			var hash_method = obj.klass._lookup_method("__hash__")
			if hash_method == null:
				return ""
			var hres = obj.klass._invoke_func(hash_method, [obj] as Array[DSLObject], {} as Dictionary[String, DSLObject])
			if not (hres is DSLInteger):
				return ""
			# CPython 的集合以「哈希 + 相等」判定: 未定义 __eq__ 时退化为身份比较,
			# 故键 = 哈希值 + (定义了 __eq__ 则留空, 否则取对象身份)
			if obj.klass._lookup_method("__eq__") != null:
				return "u:" + str(hres.value)
			return "u:" + str(hres.value) + ":" + str(obj._object_id)
		return ""

	## 添加元素, 重复元素自动去重
	func _dsl_add(obj: DSLObject) -> DSLObject:
		var k = _set_key(obj)
		if k == "":
			last_error = "TypeError: unhashable type: '%s'" % obj._type_name()
			return null
		items[k] = obj
		return DSLNone.new()

	## 移除元素, 不存在时抛 KeyError
	func _dsl_remove(obj: DSLObject) -> DSLObject:
		var k = _set_key(obj)
		if k == "":
			last_error = "TypeError: unhashable type: '%s'" % obj._type_name()
			return null
		if not items.has(k):
			last_error = "KeyError: %s" % DSLObject._py_repr(obj)
			last_error_args = [obj] as Array[DSLObject]
			return null
		items.erase(k)
		return DSLNone.new()

	## 移除元素, 不存在时不报错
	func _dsl_discard(obj: DSLObject) -> DSLObject:
		var k = _set_key(obj)
		if k != "" and items.has(k):
			items.erase(k)
		return DSLNone.new()

	## 弹出任意元素, 空集合抛 KeyError
	func _dsl_pop() -> DSLObject:
		if items.is_empty():
			last_error = "KeyError: " + DSLObject._py_repr(DSLString.new("pop from an empty set"))
			last_error_args = [DSLString.new("pop from an empty set")] as Array[DSLObject]
			return null
		var k = items.keys()[0]
		var v = items[k]
		items.erase(k)
		return v

	func _dsl_clear() -> DSLObject:
		items.clear()
		return DSLNone.new()

	func _dsl_copy() -> DSLSet:
		var s = DSLSet.new()
		s.items = items.duplicate()
		return s

	func _contains_key(obj: DSLObject) -> bool:
		var k = _set_key(obj)
		return k != "" and items.has(k)

	func _dsl_union(other) -> DSLSet:
		var s = _dsl_copy()
		for k in other.items:
			s.items[k] = other.items[k]
		return s

	func _dsl_intersection(other) -> DSLSet:
		var s = DSLSet.new()
		for k in items:
			if other.items.has(k):
				s.items[k] = items[k]
		return s

	func _dsl_difference(other) -> DSLSet:
		var s = DSLSet.new()
		for k in items:
			if not other.items.has(k):
				s.items[k] = items[k]
		return s

	func _dsl_symmetric_difference(other) -> DSLSet:
		var s = DSLSet.new()
		for k in items:
			if not other.items.has(k):
				s.items[k] = items[k]
		for k in other.items:
			if not items.has(k):
				s.items[k] = other.items[k]
		return s

	func _dsl_issubset(other) -> bool:
		for k in items:
			if not other.items.has(k):
				return false
		return true

	func _dsl_issuperset(other) -> bool:
		return other._dsl_issubset(self)

	func _dsl_isdisjoint(other) -> bool:
		for k in items:
			if other.items.has(k):
				return false
		return true

	func _dsl_bool() -> bool:
		return not items.is_empty()

	## 字符串表示 (元素排序以保证确定性, 便于与 Python 对照)
	func _dsl_str() -> String:
		# 循环引用检测: 渲染链中的集合以 {...} 截断展开 (CPython 语义)
		if not DSLObject._render_enter(self):
			return "{...}"
		if items.is_empty():
			DSLObject._render_exit(self)
			return "set()"
		var parts = []
		for k in items:
			var v = items[k]
			if v is DSLString:
				parts.append(DSLObject._py_str_repr(v.value))
			else:
				parts.append(v._dsl_str())
		parts.sort()
		DSLObject._render_exit(self)
		return "{" + ", ".join(parts) + "}"

	## repr 与 str 相同 (CPython: repr({1}) == '{1}'); 子类 repr 带类名: S9({1})
	func magic_repr(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0]
		if self_obj.klass != null and self_obj.klass.name != "set":
			var inner = self_obj._dsl_str()
			if inner == "set()":
				return DSLString.new(self_obj.klass.name + "()")
			return DSLString.new(self_obj.klass.name + "(" + inner + ")")
		return DSLString.new(self_obj._dsl_str())

