## DSL bytes 类型, 对应 Python bytes [br]
## 不可变字节串: 索引/迭代产出整数 (0-255), repr 形如 b'xy'
class DSLBytes extends DSLObject:
	## bytes 类引用 (register_builtins 注入): 字面量创建的实例未挂 klass, 方法查找经它解析
	static var _type_class: DSLClass = null
	## bytes 字面量驻留池: 等值字面量与常量折叠结果共享实例 (P2-39, is 身份)
	static var _literal_pool: Dictionary = {}

	## 取驻留的字面量实例 (无则创建并存池) [br]
	## 仅字面量/折叠路径使用, 运行期构造不共享 [br]
	## [param d] 字节数组 (元素为 0-255 的整数) [br]
	## [returns] 驻留的 DSLBytes
	static func pooled_literal(d: Array) -> DSLBytes:
		var key = PackedByteArray(d).hex_encode()
		if _literal_pool.has(key):
			return _literal_pool[key]
		var obj = DSLBytes.new(d)
		_literal_pool[key] = obj
		return obj

	## 字节数组 (每个元素 0-255)
	var data: Array[int] = []

	## 构造 bytes [br]
	## [param d] 字节数组 (元素为 0-255 的整数)
	func _init(d: Array = []):
		super._init()
		for b in d:
			data.append(int(b))

	func _type_name() -> String:
		return "bytes"

	## 属性访问: 字面量创建的实例未挂 klass, 统一经 bytes 类解析方法
	func _dsl_getattribute(name: String) -> DSLObject:
		var cls = klass if klass != null else DSLBytes._type_class
		if cls != null:
			var m = cls._dsl_getattribute(name)
			if cls.last_error != "":
				cls.last_error = ""
			if m != null and not (m is DSLNone):
				if m.has_method("__get__"):
					return m.__get__(self, cls)
				return m
		last_error = "AttributeError: 'bytes' object has no attribute '%s'" % name
		return DSLNone.new()

	## 字节长度
	func _dsl_len_hint() -> int:
		return data.size()

	## 迭代产出整数
	func magic_len(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		return DSLInteger.pooled(args[0].data.size())

	func magic_iter(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLSeqIterator:
		return DSLSeqIterator.new(args[0], "bytes_iterator")


	func _dsl_iter() -> DSLIterator:
		return DSLBytesIterator.new(self)

	## 索引/切片: 单个下标返回整数, 切片返回新 bytes
	func _dsl_getitem(index: DSLObject) -> DSLObject:
		if index is DSLSlice:
			var n = data.size()
			var res = _slice_range(index, n)
			if res == null:
				return null
			var out: Array[int] = []
			var i = int(res[0])
			var step = int(res[2])
			if step > 0:
				while i < int(res[1]):
					out.append(data[i])
					i += step
			else:
				while i > int(res[1]):
					out.append(data[i])
					i += step
			return _new_instance(out)
		var idx_i = DSLObject._norm_seq_index(index, self, "TypeError: byte indices must be integers or slices, not %s")
		if idx_i == null:
			return null
		var idx = idx_i.value
		if idx < 0:
			idx += data.size()
		if idx < 0 or idx >= data.size():
			last_error = "IndexError: index out of range"
			return null
		return DSLInteger.pooled(data[idx])

	## 计算切片下标三元组 (与 range 相同的 CPython slice.indices 语义)
	func _slice_range(slice: DSLSlice, n: int):
		var pstep = 1
		if slice.step != null:
			pstep = DSLObject._seq_index_int(slice.step, self)
			if pstep == DSLObject.INDEX_ERR:
				DSLObject._seq_index_fail(slice.step, self, "TypeError: slice indices must be integers")
				return null
		if pstep == 0:
			last_error = "ValueError: slice step cannot be zero"
			return null
		var pstart = 0 if pstep > 0 else n - 1
		var pstop = n if pstep > 0 else -1
		if slice.start != null:
			pstart = DSLObject._seq_index_int(slice.start, self)
			if pstart == DSLObject.INDEX_ERR:
				DSLObject._seq_index_fail(slice.start, self, "TypeError: slice indices must be integers")
				return null
			if pstart < 0:
				pstart += n
			pstart = clampi(pstart, (0 if pstep > 0 else -1), (n if pstep > 0 else n - 1))
		if slice.stop != null:
			pstop = DSLObject._seq_index_int(slice.stop, self)
			if pstop == DSLObject.INDEX_ERR:
				DSLObject._seq_index_fail(slice.stop, self, "TypeError: slice indices must be integers")
				return null
			if pstop < 0:
				pstop += n
			pstop = clampi(pstop, (0 if pstep > 0 else -1), (n if pstep > 0 else n - 1))
		return [pstart, pstop, pstep]

	## 成员判定: 支持单个字节 (int) 与子串 (bytes)
	func magic_contains(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var target = DSLObject._unwrap_dsl(args[1])
		if target is DSLInteger:
			for b in data:
				if b == target.value:
					return DSLBool.new(true)
				return DSLBool.new(false)
		if target is DSLBytes:
			var sub = target.data
			if sub.is_empty():
				return DSLBool.new(true)
			for i in range(data.size() - sub.size() + 1):
				var ok = true
				for j in range(sub.size()):
					if data[i + j] != sub[j]:
						ok = false
						break
				if ok:
					return DSLBool.new(true)
			return DSLBool.new(false)
		return DSLBool.new(false)

	## 相等判定: 仅与 bytes 逐字节比较 (与 str 不相等)
	func _dsl_eq(other: DSLObject) -> bool:
		var rhs = DSLObject._unwrap_dsl(other)
		if rhs is DSLBytes:
			return data == rhs.data
		return false

	func _dsl_ne(other: DSLObject) -> bool:
		return not _dsl_eq(other)

	func magic_eq(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLBool:
		return DSLBool.new(args[0]._dsl_eq(args[1]))

	func magic_ne(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLBool:
		return DSLBool.new(not args[0]._dsl_eq(args[1]))

	## repr 形如 b'xy', str() 与 repr 相同 (CPython 的 bytes 即如此)
	func _dsl_str() -> String:
		# CPython bytes repr: 单引号优先, 内容含单引号且不含双引号时改用双引号包裹
		var has_sq := false
		var has_dq := false
		for b in data:
			if b == 39:
				has_sq = true
			elif b == 34:
				has_dq = true
		var qc := 34 if has_sq and not has_dq else 39
		var s = _repr_prefix() + char(qc)
		for b in data:
			if b == 92:
				s += "\\\\"
			elif b == qc or (b == 39 and _repr_escapes_single()):
				s += String.chr(92) + char(b)
			elif b == 10:
				s += String.chr(92) + "n"
			elif b == 13:
				s += String.chr(92) + "r"
			elif b == 9:
				s += String.chr(92) + "t"
			elif b >= 32 and b < 127:
				s += char(b)
			else:
				s += String.chr(92) + "x%02x" % b
		return s + char(qc) + _repr_suffix()

	## repr 前缀 (bytearray 子类覆写为 bytearray(b 前缀))
	func _repr_prefix() -> String:
		return "b"

	## repr 后缀 (bytearray 子类补右括号)
	func _repr_suffix() -> String:
		return ""

	## 类型工厂: 可变子类覆写以返回自身类型的新实例
	func _new_instance(d: Array[int]) -> DSLBytes:
		return DSLBytes.new(d)

	## repr 转义钩子: bytearray 在双引号包裹时仍转义单引号 (CPython bytearray_repr)
	func _repr_escapes_single() -> bool:
		return false

	func magic_repr(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		return DSLString.new(args[0]._dsl_str())

	## 拼接: bytes + bytes -> 新 bytes (不允许与 str 混拼)
	func magic_add(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var other = DSLObject._unwrap_dsl(args[1])
		if other is DSLBytes:
			var out: Array[int] = []
			out.append_array(args[0].data)
			out.append_array(other.data)
			return _new_instance(out)
		last_error = "TypeError: can't concat %s to bytes" % other._type_name()
		return null

	## 重复: bytes * n -> 新 bytes
	func magic_mul(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var other = args[1]
		var reps_b = -1
		if other is DSLInteger:
			# P0-13: 重复计数为索引位 (CPython Py_ssize_t 同构)
			if (other as DSLInteger).is_big():
				last_error = "OverflowError: cannot fit 'int' into an index-sized integer"
				return null
			reps_b = other.value
		elif other is DSLBool:
			reps_b = 1 if other.value else 0
		if not (other is DSLInteger or other is DSLBool):
			last_error = "TypeError: can't multiply sequence by non-int of type '%s'" % other._type_name()
			return null
		if reps_b < 0:
			reps_b = 0
		var out: Array[int] = []
		for _i in range(reps_b):
			out.append_array(args[0].data)
		return _new_instance(out)

	func _dsl_bool() -> bool:
		return data.size() > 0

	## bytes.fromhex(s) - 十六进制串转 bytes (忽略 ASCII 空格)
	func builtin_fromhex(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		if args.size() < 1:
			last_error = "TypeError: fromhex() takes at least 1 argument"
			return null
		var hex = DSLObject._unwrap_dsl(args[0])._dsl_str().replace(" ", "")
		var digits = "0123456789abcdef"
		var lower = hex.to_lower()
		if lower.length() % 2 != 0:
			last_error = "ValueError: non-hexadecimal number found in a fromhex() arg at position %d" % (lower.length() - 1)
			return null
		var out: Array[int] = []
		for i in range(0, lower.length(), 2):
			var hi = digits.find(lower[i])
			var lo = digits.find(lower[i + 1])
			if hi < 0 or lo < 0:
				last_error = "ValueError: non-hexadecimal number found in a fromhex() arg at position %d" % i
				return null
			out.append(hi * 16 + lo)
		return _new_instance(out)

	## 字节序列字典序比较 (byte 值逐位比较)
	func _bytes_cmp(args: Array[DSLObject], op: String) -> DSLBool:
		var self_obj = args[0]
		var other = DSLObject._unwrap_dsl(args[1])
		if not (other is DSLBytes):
			self_obj.last_error = "TypeError: '%s' not supported between instances of '%s' and '%s'" % [op, self_obj._type_name(), other._type_name()]
			return DSLBool.new(false)
		var a = self_obj.data
		var b = (other as DSLBytes).data
		var n = mini(a.size(), b.size())
		var c = 0
		for i in range(n):
			if a[i] != b[i]:
				c = -1 if a[i] < b[i] else 1
				break
		if c == 0:
			if a.size() < b.size():
				c = -1
			elif a.size() > b.size():
				c = 1
		match op:
			"<":
				return DSLBool.new(c < 0)
			">":
				return DSLBool.new(c > 0)
			"<=":
				return DSLBool.new(c <= 0)
			_:
				return DSLBool.new(c >= 0)

	func magic_lt(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLBool:
		return _bytes_cmp(args, "<")

	func magic_gt(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLBool:
		return _bytes_cmp(args, ">")

	func magic_le(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLBool:
		return _bytes_cmp(args, "<=")

	func magic_ge(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLBool:
		return _bytes_cmp(args, ">=")

	## bytes 的 % 格式化 (PEP 461, P1-65) [br]
	## %b / %s 要求 bytes 类实参或实现 __bytes__ (CPython 3.12 中 %s 即 %b 别名), [br]
	## %a / %r 为 ASCII 转义形态, %c 收 0-255 整数或单字节 bytes, [br]
	## 数值 / 浮点转换与宽度精度旗标沿用 str 语义; 映射实参的 bytes 键预转 str 键; [br]
	## 实现: 格式串按 latin-1 解为字符后复用 str 的 _percent_format, 结果重编回字节
	func magic_mod(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var other = DSLObject._unwrap_dsl(args[1])
		# 格式串字节按 latin-1 解为字符 (字节与字符一一对应, 高位字节原样保留)
		var fmt_chars = ""
		for fb in args[0].data:
			fmt_chars += char(fb)
		var values: Array[DSLObject] = []
		var is_mapping = other is DSLDict
		var is_mapping_ish = other is DSLDict or other is DSLList or other is DSLRange
		if other is DSLTuple:
			values = other.items.duplicate()
		elif not is_mapping:
			values = [other]
		var spec_count = DSLObject._percent_spec_count(fmt_chars)
		if not is_mapping_ish:
			# 元组 / 单实参参与个数校验 (文案对齐 CPython, bytes formatting 后缀)
			if values.is_empty() and spec_count > 0:
				last_error = "TypeError: not enough arguments for format string"
				return null
			if values.size() < spec_count:
				last_error = "TypeError: not enough arguments for format string"
				return null
			if values.size() > spec_count:
				last_error = "TypeError: not all arguments converted during bytes formatting"
				return null
		# 预扫描: 改写 %b/%s/%a/%r/%c 为 %s 并预转换对应实参 (字节安全形态)
		var new_values: Array[DSLObject] = []
		var mapping_out: DSLDict = null
		if is_mapping:
			mapping_out = DSLDict.new()
			new_values.append(mapping_out)
		var fmt_out := ""
		var vi := 0
		var i := 0
		while i < fmt_chars.length():
			var ch = fmt_chars[i]
			if ch != "%":
				fmt_out += ch
				i += 1
				continue
			if i + 1 < fmt_chars.length() and fmt_chars[i + 1] == "%":
				fmt_out += "%%"
				i += 2
				continue
			var j := i + 1
			var key = ""
			if j < fmt_chars.length() and fmt_chars[j] == "(":
				var close = fmt_chars.find(")", j + 1)
				if close == -1:
					last_error = "ValueError: incomplete format"
					return null
				key = fmt_chars.substr(j + 1, close - j - 1)
				j = close + 1
			var spec_start := j
			while j < fmt_chars.length() and "-+ #0".contains(fmt_chars[j]):
				j += 1
			while j < fmt_chars.length() and fmt_chars[j].is_valid_int():
				j += 1
			if j < fmt_chars.length() and fmt_chars[j] == ".":
				j += 1
				while j < fmt_chars.length() and fmt_chars[j].is_valid_int():
					j += 1
			if j >= fmt_chars.length():
				last_error = "ValueError: incomplete format"
				return null
			var conv = fmt_chars[j]
			var mid := fmt_chars.substr(spec_start, j - spec_start)
			i = j + 1
			var new_conv = "s" if conv in "bsarc" else conv
			var key_part = "(" + key + ")" if key != "" else ""
			fmt_out += "%" + key_part + mid + new_conv
			if key != "":
				# 映射形式: 以 bytes 键查原始字典并按转换符预转换值
				var key_data: Array[int] = []
				for kc in key:
					key_data.append(kc.unicode_at(0))
				var key_obj = _new_instance(key_data)
				var kv = other._key_to_variant(key_obj)
				var found = null
				if kv != null and other.dict.has(kv):
					found = other.dict[kv]
				if found == null:
					last_error = "KeyError: " + key_obj._dsl_str()
					return null
				var converted_key = _bytes_convert_arg(found, conv)
				if converted_key == null:
					return null
				mapping_out._dsl_setitem(DSLString.new(key), converted_key)
			else:
				var val = values[vi] if vi < values.size() else null
				vi += 1
				var converted = _bytes_convert_arg(val, conv)
				if converted == null:
					return null
				new_values.append(converted)
		var tmp = DSLString.new("")
		var formatted = tmp._percent_format(fmt_out, new_values)
		if tmp.last_error != "":
			last_error = tmp.last_error
			return null
		var out_data: Array[int] = []
		for oc in formatted:
			var u = oc.unicode_at(0)
			if u > 255:
				last_error = "UnicodeEncodeError: ascii codec cannot encode the formatting result"
				return null
			out_data.append(u)
		return _new_instance(out_data)

	## bytes 格式化的单实参预转换 (b/s/a/r/c 转为字符安全形态) [br]
	## [param val] 原实参 [br]
	## [param conv] 转换符 [br]
	## [returns] 转换后的 DSLObject, 出错返回 null 并置 last_error
	func _bytes_convert_arg(val: DSLObject, conv: String) -> DSLObject:
		if val == null:
			return null
		if conv == "b" or conv == "s":
			return _bytes_val_to_str(val)
		if conv == "a" or conv == "r":
			return DSLString.new(_bytes_ascii_repr(val))
		if conv == "c":
			var raw_c = DSLObject._unwrap_dsl(val)
			if raw_c is DSLBool:
				return DSLString.new(char(1 if raw_c.value else 0))
			if raw_c is DSLInteger:
				if raw_c.value < 0 or raw_c.value > 255:
					last_error = "OverflowError: %c arg not in range(256)"
					return null
				return DSLString.new(char(raw_c.value))
			if raw_c is DSLBytes:
				if raw_c.data.size() != 1:
					last_error = "TypeError: %c requires an integer in range(256) or a single byte"
					return null
				return DSLString.new(char(raw_c.data[0]))
			last_error = "TypeError: %c requires an integer in range(256) or a single byte"
			return null
		# 数值 / 浮点转换原样交给 str 机制 (类型校验文案与 CPython 同族)
		return val

	## %b / %s 的实参转换: bytes 类实参按 latin-1 转字符, 其余报 CPython 文案 [br]
	## 支持 __bytes__ 协议 (返回值须为 bytes)
	func _bytes_val_to_str(val: DSLObject) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(val)
		if raw is DSLBytes:
			var s := ""
			for b in raw.data:
				s += char(b)
			return DSLString.new(s)
		if raw.klass != null:
			var m = raw.klass._lookup_method("__bytes__")
			if m != null:
				if m.has_method("__get__"):
					m = m.__get__(raw, raw.klass)
				var call_args: Array[DSLObject] = []
				var r = raw.klass._invoke_func(m, call_args, {} as Dictionary[String, DSLObject])
				if r == null:
					return null
				if r is DSLBytes:
					var s2 := ""
					for b2 in r.data:
						s2 += char(b2)
					return DSLString.new(s2)
				last_error = "TypeError: __bytes__ returned non-bytes (type %s)" % r._type_name()
				return null
		last_error = "TypeError: %b requires a bytes-like object, or an object that implements __bytes__, not '%s'" % raw._type_name()
		return null

	## ASCII 转义形态 (CPython bytes %a / %r): repr 后将非 ASCII 字符转义
	func _bytes_ascii_repr(obj: DSLObject) -> String:
		var r = obj.magic_repr([obj] as Array[DSLObject], {} as Dictionary[String, DSLObject])
		var src = r.value if r is DSLString else obj._dsl_str()
		var out := ""
		for ch in src:
			var u = ch.unicode_at(0)
			if u < 128:
				out += ch
			elif u <= 0xFF:
				out += String.chr(92) + "x%02x" % u
			elif u <= 0xFFFF:
				out += String.chr(92) + "u%04x" % u
			else:
				out += String.chr(92) + "U%08x" % u
		return out


	## 把实参转为字节数组 (bytes / int 可迭代)
	func _bytes_arg_to_data(obj: DSLObject) -> Array[int]:
		var raw = DSLObject._unwrap_dsl(obj)
		var out: Array[int] = []
		if raw is DSLBytes:
			out.assign(raw.data)
			return out
		if raw is DSLList or raw is DSLTuple:
			for it in raw.items:
				if it is DSLInteger and it.value >= 0 and it.value <= 255:
					out.append(it.value)
			return out
		return out

	## 在 data 中查找子序列, 返回首个下标 (找不到返回 -1)
	func _bytes_find(hay: Array[int], needle: Array[int], start: int, end: int) -> int:
		if needle.is_empty():
			return maxi(start, 0)
		var m = needle.size()
		var i = maxi(start, 0)
		while i <= end - m:
			var ok = true
			for j in range(m):
				if hay[i + j] != needle[j]:
					ok = false
					break
			if ok:
				return i
			i += 1
		return -1

	func builtin_decode(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var encoding = "utf-8"
		if args.size() >= 2 and args[1] is DSLString:
			encoding = args[1].value
		var errors = "strict"
		if args.size() >= 3 and args[2] is DSLString:
			errors = args[2].value
		var data = raw.data
		if encoding == "latin-1" or encoding == "latin1" or encoding == "iso-8859-1":
			# latin-1 与码点一一对应, 永不失败 (CPython 语义)
			var ls = ""
			for b in data:
				ls += char(b)
			return DSLString.new(ls)
		if encoding == "ascii":
			var asc = ""
			for i in range(data.size()):
				var b = data[i]
				if b >= 128:
					if errors == "replace":
						asc += char(0xFFFD)
					elif errors == "ignore":
						pass
					else:
						last_error = "UnicodeDecodeError: 'ascii' codec can't decode byte 0x%02x in position %d: ordinal not in range(128)" % [b, i]
						return null
				else:
					asc += char(b)
			return DSLString.new(asc)
		if encoding == "utf-8" or encoding == "utf8":
			# 逐字节 UTF-8 解码: 非法序列按 errors 处理 (strict 报错 / replace 换 U+FFFD / ignore 跳过)
			var us = ""
			var i = 0
			while i < data.size():
				var b = data[i]
				var need = 0
				var cp = 0
				if b < 0x80:
					us += char(b)
					i += 1
					continue
				elif b >= 0xC2 and b <= 0xDF:
					need = 1
					cp = b & 0x1F
				elif b >= 0xE0 and b <= 0xEF:
					need = 2
					cp = b & 0x0F
				elif b >= 0xF0 and b <= 0xF4:
					need = 3
					cp = b & 0x07
				else:
					if errors == "replace":
						us += char(0xFFFD)
						i += 1
						continue
					elif errors == "ignore":
						i += 1
						continue
					last_error = "UnicodeDecodeError: 'utf-8' codec can't decode byte 0x%02x in position %d: invalid start byte" % [b, i]
					return null
				var ok = i + need < data.size()
				var val = cp
				if ok:
					for c in range(need):
						var nb = data[i + 1 + c]
						if nb < 0x80 or nb > 0xBF:
							ok = false
							break
						val = (val << 6) | (nb & 0x3F)
				if not ok:
					if errors == "replace":
						us += char(0xFFFD)
						i += 1
						continue
					elif errors == "ignore":
						i += 1
						continue
					last_error = "UnicodeDecodeError: 'utf-8' codec can't decode byte 0x%02x in position %d: invalid start byte" % [data[i], i]
					return null
				us += char(val)
				i += 1 + need
			return DSLString.new(us)
		last_error = "LookupError: unknown encoding: %s" % encoding
		return null

	func builtin_hex(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var sep = ""
		if _kwargs.has("sep"):
			sep = _kwargs["sep"]._dsl_str()
		elif args.size() >= 2 and args[1] is DSLString:
			sep = args[1].value
		var s = ""
		for i in range(raw.data.size()):
			if i > 0 and sep != "":
				s += sep
			s += "%02x" % raw.data[i]
		return DSLString.new(s)

	func builtin_upper(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var out: Array[int] = []
		for b in raw.data:
			out.append(b - 32 if b >= 97 and b <= 122 else b)
		return _new_instance(out)

	func builtin_lower(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var out: Array[int] = []
		for b in raw.data:
			out.append(b + 32 if b >= 65 and b <= 90 else b)
		return _new_instance(out)

	func builtin_title(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var out: Array[int] = []
		var prev_letter = false
		for b in raw.data:
			var is_letter = (b >= 97 and b <= 122) or (b >= 65 and b <= 90)
			if is_letter and not prev_letter and b >= 97 and b <= 122:
				b -= 32
			elif is_letter and prev_letter and b >= 65 and b <= 90:
				b += 32
			out.append(b)
			prev_letter = is_letter
		return _new_instance(out)

	## strip 家族的字符集: 显式 chars 参数为 bytes 时取其字节, 缺省为 ASCII 空白
	func _strip_char_set(args: Array[DSLObject]) -> Dictionary:
		var chars = {}
		if args.size() >= 2 and args[1] is DSLBytes:
			for b in args[1].data:
				chars[b] = true
		else:
			for b in [32, 9, 10, 13, 11, 12]:
				chars[b] = true
		return chars

	func _is_byte_space(b: int) -> bool:
		return b == 32 or b == 9 or b == 10 or b == 13 or b == 11 or b == 12

	func builtin_strip(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var chars = _strip_char_set(args)
		var lo = 0
		var hi = raw.data.size()
		while lo < hi and chars.has(raw.data[lo]):
			lo += 1
		while hi > lo and chars.has(raw.data[hi - 1]):
			hi -= 1
		return _new_instance(raw.data.slice(lo, hi))

	func builtin_lstrip(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var chars = _strip_char_set(args)
		var lo = 0
		while lo < raw.data.size() and chars.has(raw.data[lo]):
			lo += 1
		return _new_instance(raw.data.slice(lo))

	func builtin_rstrip(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var chars = _strip_char_set(args)
		var hi = raw.data.size()
		while hi > 0 and chars.has(raw.data[hi - 1]):
			hi -= 1
		return _new_instance(raw.data.slice(0, hi))

	func builtin_split(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var sep_data: Array[int] = []
		var has_sep = false
		if args.size() >= 2 and args[1] is DSLBytes:
			sep_data = args[1].data
			has_sep = true
		var maxsplit = -1
		if args.size() >= 3 and args[2] is DSLInteger:
			maxsplit = args[2].value
		var parts: Array[DSLObject] = []
		var cur: Array[int] = []
		var i = 0
		var n = raw.data.size()
		if has_sep:
			var m = sep_data.size()
			while i < n:
				if maxsplit >= 0 and parts.size() >= maxsplit:
					break
				var pos = _bytes_find(raw.data, sep_data, i, n)
				if pos < 0:
					break
				parts.append(_new_instance(raw.data.slice(i, pos)))
				i = pos + m
			parts.append(_new_instance(raw.data.slice(i)))
		else:
			while i < n:
				if _is_byte_space(raw.data[i]):
					if cur.size() > 0:
						parts.append(_new_instance(cur))
						cur = []
					i += 1
				elif maxsplit >= 0 and parts.size() >= maxsplit:
					cur = raw.data.slice(i)
					break
				else:
					cur.append(raw.data[i])
					i += 1
			if cur.size() > 0:
				parts.append(_new_instance(cur))
		return DSLList.new(parts)

	func builtin_replace(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var old_data = _bytes_arg_to_data(args[1])
		var new_data = _bytes_arg_to_data(args[2])
		var count = -1
		if args.size() >= 4 and args[3] is DSLInteger:
			count = args[3].value
		var out: Array[int] = []
		var i = 0
		var n = raw.data.size()
		var done = 0
		while i < n:
			if count >= 0 and done >= count:
				break
			var pos = _bytes_find(raw.data, old_data, i, n)
			if pos < 0:
				break
			for j in range(i, pos):
				out.append(raw.data[j])
			out.append_array(new_data)
			i = pos + old_data.size()
			done += 1
		for j in range(i, n):
			out.append(raw.data[j])
		return _new_instance(out)

	func builtin_find(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var sub = _bytes_arg_to_data(args[1])
		var start = args[2].value if args.size() >= 3 and args[2] is DSLInteger else 0
		var end = args[3].value if args.size() >= 4 and args[3] is DSLInteger else raw.data.size()
		return DSLInteger.pooled(_bytes_find(raw.data, sub, start, end))

	func builtin_index(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var pos = builtin_find(args, _kwargs)
		if pos is DSLInteger and pos.value < 0:
			last_error = "ValueError: substring not found"
			return null
		return pos

	func builtin_count(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var sub = _bytes_arg_to_data(args[1])
		var total = 0
		var i = 0
		while i <= raw.data.size() - sub.size():
			var pos = _bytes_find(raw.data, sub, i, raw.data.size())
			if pos < 0:
				break
			total += 1
			i = pos + maxi(sub.size(), 1)
		return DSLInteger.pooled(total)

	func builtin_startswith(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var sub = _bytes_arg_to_data(args[1])
		return DSLBool.new(raw.data.size() >= sub.size() and _bytes_find(raw.data, sub, 0, sub.size()) == 0)

	func builtin_endswith(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var sub = _bytes_arg_to_data(args[1])
		var off = raw.data.size() - sub.size()
		return DSLBool.new(off >= 0 and _bytes_find(raw.data, sub, off, raw.data.size()) == off)

	func builtin_join(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var it = args[1]._dsl_iter()
		if it == null:
			last_error = "TypeError: can only join an iterable"
			return null
		var out: Array[int] = []
		var first = true
		while it.has_next():
			var item = it.next()
			if it.suspended:
				break
			var seg = _bytes_arg_to_data(item)
			if not first:
				out.append_array(raw.data)
			out.append_array(seg)
			first = false
		return _new_instance(out)

	func builtin_center(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var fill = _fill_bytes(args)
		if args[1] is DSLInteger and (args[1] as DSLInteger).is_big():
			raw.last_error = "OverflowError: Python int too large to convert to C ssize_t"
			return null
		var width = args[1].value if args[1] is DSLInteger else raw.data.size()
		var total = width - raw.data.size()
		var left = total / 2
		var res: Array[int] = []
		for i in range(maxi(left, 0)):
			res.append(fill[i % fill.size()])
		res.append_array(raw.data)
		for i in range(maxi(total - left, 0)):
			res.append(fill[(i + left) % fill.size()])
		return _new_instance(res)

	func builtin_ljust(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var fill = _fill_bytes(args)
		if args[1] is DSLInteger and (args[1] as DSLInteger).is_big():
			raw.last_error = "OverflowError: Python int too large to convert to C ssize_t"
			return null
		var width = args[1].value if args[1] is DSLInteger else raw.data.size()
		var res: Array[int] = []
		res.append_array(raw.data)
		for i in range(maxi(width - raw.data.size(), 0)):
			res.append(fill[i % fill.size()])
		return _new_instance(res)

	func builtin_rjust(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var raw = DSLObject._unwrap_dsl(args[0])
		var fill = _fill_bytes(args)
		if args[1] is DSLInteger and (args[1] as DSLInteger).is_big():
			raw.last_error = "OverflowError: Python int too large to convert to C ssize_t"
			return null
		var width = args[1].value if args[1] is DSLInteger else raw.data.size()
		var res: Array[int] = []
		for i in range(maxi(width - raw.data.size(), 0)):
			res.append(fill[i % fill.size()])
		res.append_array(raw.data)
		return _new_instance(res)

	func _fill_bytes(args: Array[DSLObject]) -> Array[int]:
		if args.size() >= 3 and args[2] is DSLBytes and args[2].data.size() > 0:
			return args[2].data
		return [32]

## bytes 的迭代器 (产出整数)
## DSL 可变字节数组, 对应 Python bytearray (P1-32) [br]
## 继承 DSLBytes 复用全部只读方法 (upper/decode/hex 等经类型工厂返回 bytearray), [br]
## 追加可变语义: 下标赋值/删除与 append/extend/insert/pop/remove/clear/copy/reverse
class DSLByteArray extends DSLBytes:
	func _type_name() -> String:
		return "bytearray"

	## repr: bytearray(b'...') 形态
	func _repr_prefix() -> String:
		return "bytearray(b"

	func _repr_suffix() -> String:
		return ")"

	## bytearray repr: 双引号包裹时仍转义单引号
	func _repr_escapes_single() -> bool:
		return true

	## 类型工厂: bytearray 的方法一律产出 bytearray
	func _new_instance(d: Array[int]) -> DSLBytes:
		return DSLByteArray.new(d)

	## 校验字节值并在越界时报 CPython 文案
	func _check_byte(v: int) -> bool:
		if v < 0 or v > 255:
			last_error = "ValueError: byte must be in range(0, 256)"
			return false
		return true

	## bytearray.append(b)
	func builtin_append(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLByteArray
		var v = DSLObject._unwrap_dsl(args[1])
		if not (v is DSLInteger):
			last_error = "TypeError: '%s' object cannot be interpreted as an integer" % v._type_name()
			return null
		if not self_obj._check_byte(v.value):
			return null
		self_obj.data.append(v.value)
		return DSLNone.new()

	## bytearray.extend(iterable of ints / bytes / bytearray)
	func builtin_extend(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLByteArray
		var src = DSLObject._unwrap_dsl(args[1])
		if src is DSLBytes:
			self_obj.data.append_array(src.data)
			return DSLNone.new()
		var items: Array = []
		if src is DSLList or src is DSLTuple:
			items = src.items
		elif src is DSLRange:
			for i in range(src._length()):
				items.append(src._at(i))
		else:
			last_error = "TypeError: '%s' object cannot be interpreted as an integer" % src._type_name()
			return null
		for it in items:
			if not (it is DSLInteger):
				last_error = "TypeError: '%s' object cannot be interpreted as an integer" % it._type_name()
				return null
			if not self_obj._check_byte(it.value):
				return null
			self_obj.data.append(it.value)
		return DSLNone.new()

	## bytearray.insert(i, b)
	func builtin_insert(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLByteArray
		var idx = DSLObject._unwrap_dsl(args[1])
		var v = DSLObject._unwrap_dsl(args[2])
		if not (idx is DSLInteger) or not (v is DSLInteger):
			last_error = "TypeError: an integer is required"
			return null
		if not self_obj._check_byte(v.value):
			return null
		var i = idx.value
		if i < 0:
			i = maxi(0, self_obj.data.size() + i)
		self_obj.data.insert(mini(i, self_obj.data.size()), v.value)
		return DSLNone.new()

	## bytearray.pop([i]) -> int
	func builtin_pop(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLByteArray
		if self_obj.data.is_empty():
			last_error = "IndexError: pop from empty bytearray"
			return null
		var i = self_obj.data.size() - 1
		if args.size() >= 2:
			var pi = DSLObject._unwrap_dsl(args[1])
			if not (pi is DSLInteger):
				last_error = "TypeError: an integer is required"
				return null
			i = pi.value
			if i < 0:
				i += self_obj.data.size()
			if i < 0 or i >= self_obj.data.size():
				last_error = "IndexError: pop index out of range"
				return null
		var v = self_obj.data[i]
		self_obj.data.remove_at(i)
		return DSLInteger.pooled(v)

	## bytearray.remove(b)
	func builtin_remove(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLByteArray
		var v = DSLObject._unwrap_dsl(args[1])
		if not (v is DSLInteger):
			last_error = "TypeError: '%s' object cannot be interpreted as an integer" % v._type_name()
			return null
		if not self_obj._check_byte(v.value):
			return null
		var idx = self_obj.data.find(v.value)
		if idx < 0:
			last_error = "ValueError: value not in bytearray"
			return null
		self_obj.data.remove_at(idx)
		return DSLNone.new()

	## bytearray.reverse()
	func builtin_reverse(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLByteArray
		self_obj.data.reverse()
		return DSLNone.new()

	## bytearray.clear()
	func builtin_clear_ba(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		(args[0] as DSLByteArray).data.clear()
		return DSLNone.new()

	## bytearray.copy()
	func builtin_copy_ba(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLByteArray
		var out: Array[int] = []
		out.assign(self_obj.data)
		return DSLByteArray.new(out)

	## bytearray.copy() 与 bytes.copy() 同名: bytes 侧经 bytes 类解析, bytearray 侧经本类解析
	func builtin_copy(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		return builtin_copy_ba(args, _kwargs)

	## bytearray.pop 与 bytes 类无冲突; remove/clear 同理经本类解析
	## 下标赋值: 整数为字节值, 切片为 bytes/bytearray/整数可迭代
	func _dsl_setitem(index: DSLObject, value: DSLObject):
		var self_obj = self
		var val = DSLObject._unwrap_dsl(value)
		if index is DSLSlice:
			var n = data.size()
			var res = _slice_range(index, n)
			if res == null:
				return
			var new_vals: Array[int] = []
			if not _collect_byte_values(val, new_vals):
				return
			var start = int(res[0])
			var stop = int(res[1])
			var step = int(res[2])
			if step == 1:
				var head: Array[int] = data.slice(0, start)
				var tail: Array[int] = data.slice(stop)
				data = head
				data.append_array(new_vals)
				data.append_array(tail)
				return
			var slot_count = 0
			if step > 0:
				slot_count = ceili(float(stop - start) / float(step)) if stop > start else 0
			else:
				slot_count = ceili(float(start - stop) / float(-step)) if stop < start else 0
			if slot_count != new_vals.size():
				last_error = "ValueError: attempt to assign bytes of size %d to extended slice of size %d" % [new_vals.size(), slot_count]
				return
			var si = start
			for vi in range(new_vals.size()):
				data[si] = new_vals[vi]
				si += step
			return
		if not (val is DSLInteger):
			last_error = "TypeError: '%s' object cannot be interpreted as an integer" % val._type_name()
			return
		if not self_obj._check_byte(val.value):
			return
		var idx_i = DSLObject._norm_seq_index(index, self, "TypeError: bytearray indices must be integers, not %s")
		if idx_i == null:
			return
		var idx = idx_i.value
		if idx < 0 or idx >= data.size():
			last_error = "IndexError: bytearray index out of range"
			return
		data[idx] = val.value

	## bytearray.delitem: 整数与切片
	func _dsl_delitem(index: DSLObject):
		if index is DSLSlice:
			var n = data.size()
			var res = _slice_range(index, n)
			if res == null:
				return
			var start = int(res[0])
			var stop = int(res[1])
			var step = int(res[2])
			var drop := {}
			var si = start
			while (step > 0 and si < stop) or (step < 0 and si > stop):
				drop[si] = true
				si += step
			var kept: Array[int] = []
			for i in range(data.size()):
				if not drop.has(i):
					kept.append(data[i])
			data = kept
			return
		var idx_i = DSLObject._norm_seq_index(index, self, "TypeError: bytearray indices must be integers, not %s")
		if idx_i == null:
			return
		var idx = idx_i.value
		if idx < 0 or idx >= data.size():
			last_error = "IndexError: bytearray index out of range"
			return
		data.remove_at(idx)

	## 收集可迭代对象的字节值 (bytes/bytearray/整数可迭代)
	func _collect_byte_values(val: DSLObject, out: Array[int]) -> bool:
		if val is DSLBytes:
			out.assign(val.data)
			return true
		var items: Array = []
		if val is DSLList or val is DSLTuple:
			items = val.items
		else:
			last_error = "TypeError: can't assign a non-byte object to a bytearray slice"
			return false
		for it in items:
			if not (it is DSLInteger):
				last_error = "TypeError: '%s' object cannot be interpreted as an integer" % it._type_name()
				return false
			if not _check_byte(it.value):
				return false
			out.append(it.value)
		return true

## DSL 内存视图, 对应 Python memoryview (P1-32) [br]
## 务实子集: B 格式一维视图, 支持 len/下标/切片/迭代/tobytes/hex/cast('B')/release; [br]
## bytes 底层只读 (赋值报 cannot modify read-only memory), bytearray 底层可写透传
class DSLMemoryView extends DSLObject:
	## 底层字节对象 (DSLBytes 或 DSLByteArray)
	var _obj: DSLBytes
	## 视图起始偏移
	var _offset: int = 0
	## 视图长度
	var _size: int = 0
	## 是否已释放
	var _released: bool = false
	## memoryview 类引用
	static var _type_class: DSLClass = null
	## magic 方法描述符缓存
	var _mv_magic_descriptors: Dictionary = {}

	## 构造视图 [br]
	## [param p_obj] 底层字节对象 [br]
	## [param p_offset] 起始偏移 [br]
	## [param p_size] 视图长度
	func _init(p_obj: DSLBytes, p_offset: int = 0, p_size: int = -1):
		super._init()
		_obj = p_obj
		_offset = p_offset
		_size = p_size if p_size >= 0 else p_obj.data.size() - p_offset

	func _type_name() -> String:
		return "memoryview"

	func _dsl_str() -> String:
		return "<memory at 0x%x>" % _object_id

	## 底层是否只读 (bytes 为只读, bytearray 可写)
	func _is_readonly() -> bool:
		return not (_obj is DSLByteArray)

	## 取视图区间的字节副本
	func _snapshot() -> DSLBytes:
		var out: Array[int] = []
		for i in range(_offset, _offset + _size):
			out.append(_obj.data[i])
		return DSLBytes.new(out)

	## 已释放检查: 释放后的操作统一报错
	func _check_released() -> bool:
		if _released:
			last_error = "ValueError: operation forbidden on released memoryview object"
			return false
		return true

	## 把下标规范化为视图内偏移, 越界报 IndexError
	func _resolve_index(index: DSLObject) -> int:
		if not (index is DSLInteger):
			last_error = "TypeError: memoryview index must be integer, not '%s'" % index._type_name()
			return -2147483648
		var i = index.value
		if i < 0:
			i += _size
		if i < 0 or i >= _size:
			last_error = "IndexError: index out of bounds on dimension 1"
			return -2147483648
		return i

	## 底层字节数组的可变引用读取 (切片赋值透传用)
	func _writable_data() -> Array[int]:
		return (_obj as DSLByteArray).data

	func magic_len(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		if not (args[0] as DSLMemoryView)._check_released():
			return null
		return DSLInteger.pooled((args[0] as DSLMemoryView)._size)

	func _dsl_len_hint() -> int:
		return _size

	func magic_iter(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLIterator:
		var self_obj = args[0] as DSLMemoryView
		if not self_obj._check_released():
			return null
		return self_obj._dsl_iter()

	func _dsl_iter() -> DSLIterator:
		var view = _snapshot()
		return DSLBytesIterator.new(view)

	func _dsl_getitem(index: DSLObject) -> DSLObject:
		if not _check_released():
			return null
		if index is DSLSlice:
			var res = _slice_range(index, _size)
			if res == null:
				return null
			return DSLMemoryView.new(_obj, _offset + int(res[0]), int(res[2]) * (int(res[1]) - int(res[0])) if int(res[2]) > 0 else 0)
		var i = _resolve_index(index)
		if i == -2147483648:
			return null
		return DSLInteger.pooled(_obj.data[_offset + i])

	## 切片范围计算 (与 bytes._slice_range 同规则, 视图局部坐标)
	func _slice_range(slice: DSLSlice, n: int):
		var pstep = 1
		if slice.step != null:
			var pstep_i = DSLObject._seq_index_int(slice.step, self)
			if pstep_i == DSLObject.INDEX_ERR:
				DSLObject._seq_index_fail(slice.step, self, "TypeError: slice indices must be integers")
				return null
			pstep = pstep_i.value
			if pstep == 0:
				last_error = "ValueError: slice step cannot be zero"
				return null
		var pstart = 0 if pstep > 0 else n - 1
		var pstop = n if pstep > 0 else -1
		if slice.start != null:
			pstart = DSLObject._seq_index_int(slice.start, self)
			if pstart == DSLObject.INDEX_ERR:
				DSLObject._seq_index_fail(slice.start, self, "TypeError: slice indices must be integers")
				return null
			if pstart < 0:
				pstart += n
			pstart = clampi(pstart, (0 if pstep > 0 else -1), (n if pstep > 0 else n - 1))
		if slice.stop != null:
			pstop = DSLObject._seq_index_int(slice.stop, self)
			if pstop == DSLObject.INDEX_ERR:
				DSLObject._seq_index_fail(slice.stop, self, "TypeError: slice indices must be integers")
				return null
			if pstop < 0:
				pstop += n
			pstop = clampi(pstop, (0 if pstep > 0 else -1), (n if pstep > 0 else n - 1))
		return [pstart, pstop, pstep]

	## 下标赋值: 只读报错, 可写透传到底层 bytearray
	func _dsl_setitem(index: DSLObject, value: DSLObject):
		if not _check_released():
			return
		if _is_readonly():
			last_error = "TypeError: cannot modify read-only memory"
			return
		var val = DSLObject._unwrap_dsl(value)
		if not (val is DSLInteger):
			last_error = "TypeError: memoryview assignments can only be integer"
			return
		if val.value < 0 or val.value > 255:
			last_error = "ValueError: memoryview assignment: byte must be in range(0, 256)"
			return
		var i = _resolve_index(index)
		if i == -2147483648:
			return
		_writable_data()[_offset + i] = val.value

	func _dsl_eq(other: DSLObject) -> bool:
		var rhs = DSLObject._unwrap_dsl(other)
		if rhs is DSLMemoryView:
			if rhs._size != _size:
				return false
			for i in range(_size):
				if _obj.data[_offset + i] != rhs._obj.data[rhs._offset + i]:
					return false
			return true
		if rhs is DSLBytes:
			if rhs.data.size() != _size:
				return false
			for i in range(_size):
				if _obj.data[_offset + i] != rhs.data[i]:
					return false
			return true
		return false

	func magic_eq(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLBool:
		return DSLBool.new((args[0] as DSLMemoryView)._dsl_eq(args[1]))

	func magic_ne(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLBool:
		return DSLBool.new(not (args[0] as DSLMemoryView)._dsl_eq(args[1]))

	func _dsl_bool() -> bool:
		return _size > 0

	## memoryview.tobytes()
	func builtin_tobytes(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLMemoryView
		if not self_obj._check_released():
			return null
		var out: Array[int] = []
		for i in range(self_obj._offset, self_obj._offset + self_obj._size):
			out.append(self_obj._obj.data[i])
		return DSLBytes.new(out)

	## memoryview.hex()
	func builtin_hex(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLMemoryView
		if not self_obj._check_released():
			return null
		var out = ""
		for i in range(self_obj._offset, self_obj._offset + self_obj._size):
			out += "%02x" % self_obj._obj.data[i]
		return DSLString.new(out)

	## memoryview.cast(fmt): 务实仅支持 'B' (一维字节视图)
	func builtin_cast(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLMemoryView
		if not self_obj._check_released():
			return null
		var fmt = DSLObject._unwrap_dsl(args[1])
		if not (fmt is DSLString) or (fmt as DSLString).value != "B":
			last_error = "ValueError: memoryview: destination format must be 'B'"
			return null
		return DSLMemoryView.new(self_obj._obj, self_obj._offset, self_obj._size)

	## memoryview.release()
	func builtin_release(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		(args[0] as DSLMemoryView)._released = true
		return DSLNone.new()

	## memoryview.obj
	func builtin_obj_attr(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLMemoryView
		if not self_obj._check_released():
			return null
		return self_obj._obj

	## 内省属性: readonly/obj/nbytes/itemsize/format/shape/ndim/suboffsets/cast/tolist?? 经 _dsl_getattribute
	func _dsl_getattribute(name: String) -> DSLObject:
		if name == "readonly":
			if not _check_released():
				return null
			return DSLBool.new(_is_readonly())
		if name == "obj":
			if not _check_released():
				return null
			return _obj
		if name == "nbytes":
			if not _check_released():
				return null
			return DSLInteger.pooled(_size)
		if name == "itemsize":
			return DSLInteger.pooled(1)
		if name == "format":
			return DSLString.new("B")
		if name == "ndim":
			return DSLInteger.pooled(1)
		if name == "shape":
			if not _check_released():
				return null
			var shape_items: Array[DSLObject] = [DSLInteger.pooled(_size)]
			return DSLTuple.new(shape_items)
		if name == "suboffsets":
			return DSLTuple.new([] as Array[DSLObject])
		if name == "c_contiguous" or name == "f_contiguous":
			return DSLBool.new(true)
		if _mv_magic_descriptors.is_empty():
			_init_magic_descriptors()
		if _mv_magic_descriptors.has(name):
			return _mv_magic_descriptors[name].__get__(self, null)
		var cls = klass if klass != null else DSLMemoryView._type_class
		if cls != null:
			var m = cls._dsl_getattribute(name)
			if cls.last_error != "":
				cls.last_error = ""
			if m != null and not (m is DSLNone):
				if m.has_method("__get__"):
					return m.__get__(self, cls)
				return m
		return super._dsl_getattribute(name)

	## 初始化魔法方法描述符字典 (memoryview)
	func _init_magic_descriptors():
		_mv_magic_descriptors = {
			"__eq__": DSLWrappedDescriptor.new("__eq__", Callable(self, "magic_eq")),
			"__ne__": DSLWrappedDescriptor.new("__ne__", Callable(self, "magic_ne")),
			"__len__": DSLWrappedDescriptor.new("__len__", Callable(self, "magic_len")),
			"__iter__": DSLWrappedDescriptor.new("__iter__", Callable(self, "magic_iter")),
			"tobytes": DSLMethodDescriptor.new("tobytes", Callable(self, "builtin_tobytes")),
			"hex": DSLMethodDescriptor.new("hex", Callable(self, "builtin_hex")),
			"cast": DSLMethodDescriptor.new("cast", Callable(self, "builtin_cast")),
			"release": DSLMethodDescriptor.new("release", Callable(self, "builtin_release")),
		}

## DSL 有序字典, 对应 Python collections.OrderedDict (P1-32) [br]
## 继承 dict 全部行为; 追加: move_to_end / popitem(last) / repr 前缀 / [br]
## OrderedDict 间相等比较按键序敏感 (与普通 dict 比较仍为键序无关)
class DSLOrderedDict extends DSLDict:
	func _init():
		super._init()

	func _type_name() -> String:
		return "OrderedDict"

	func _dsl_str() -> String:
		# 空字典 CPython 为 OrderedDict() (无花括号)
		if dict.is_empty():
			return "OrderedDict()"
		return "OrderedDict(" + super._dsl_str() + ")"

	## 把键移动到末尾或开头 (删除后按需重建, 保持其余键相对顺序)
	func builtin_move_to_end(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLOrderedDict
		if args.size() < 2:
			last_error = "TypeError: move_to_end() missing 1 required positional argument: 'key'"
			return null
		var vkey = self_obj._key_to_variant(args[1])
		if vkey == null or not self_obj.dict.has(vkey):
			last_error = "KeyError: " + DSLObject._py_repr(args[1])
			return null
		var last = true
		if _kwargs.has("last"):
			last = _kwargs["last"]._dsl_bool()
		elif args.size() >= 3:
			last = args[2]._dsl_bool()
		if last:
			var val = self_obj.dict[vkey]
			self_obj.dict.erase(vkey)
			self_obj.dict[vkey] = val
		else:
			var val2 = self_obj.dict[vkey]
			var entries := []
			for k in self_obj.dict:
				if k != vkey:
					entries.append([k, self_obj.dict[k]])
			self_obj.dict.clear()
			self_obj.dict[vkey] = val2
			for e in entries:
				self_obj.dict[e[0]] = e[1]
		return DSLNone.new()

	## popitem(last=True): 弹出末尾 (或首个) 键值对, 空字典报 KeyError
	func builtin_popitem_od(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLOrderedDict
		if self_obj.dict.is_empty():
			last_error = "KeyError: 'dictionary is empty'"
			return null
		var last = true
		if _kwargs.has("last"):
			last = _kwargs["last"]._dsl_bool()
		elif args.size() >= 2:
			last = args[1]._dsl_bool()
		var vkey = null
		if last:
			var keys = self_obj.dict.keys()
			vkey = keys[keys.size() - 1]
		else:
			for k in self_obj.dict:
				vkey = k
				break
		var val = self_obj.dict[vkey]
		var key_obj = self_obj._original_key_obj(vkey)
		self_obj.dict.erase(vkey)
		var out_items: Array[DSLObject] = [key_obj, val]
		return DSLTuple.new(out_items)

	## OrderedDict.copy() 仍为 OrderedDict
	func builtin_copy_od(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0] as DSLOrderedDict
		var out = DSLOrderedDict.new()
		for k in self_obj.dict:
			out.dict[k] = self_obj.dict[k]
		out._complex_keys.assign(self_obj._complex_keys)
		return out

	## OrderedDict 间相等为键序敏感; 与普通 dict 比较退化为键序无关
	func magic_eq(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLBool:
		var self_obj = args[0]
		var other = DSLObject._unwrap_dsl(args[1])
		if other is DSLOrderedDict:
			if self_obj.dict.size() != other.dict.size():
				return DSLBool.new(false)
			var a_keys = self_obj.dict.keys()
			var b_keys = other.dict.keys()
			for i in range(a_keys.size()):
				if a_keys[i] != b_keys[i]:
					return DSLBool.new(false)
				if not self_obj.dict[a_keys[i]]._dsl_eq(other.dict[b_keys[i]]):
					return DSLBool.new(false)
			return DSLBool.new(true)
		return super.magic_eq(args, _kwargs)

	## 类方法查找: 与 dict 同表 + 本类追加方法
	func _dsl_getattribute(name: String) -> DSLObject:
		if name == "move_to_end" or name == "popitem" or name == "copy":
			var od_cls = klass if klass != null else DSLOrderedDict._type_class
			if od_cls != null:
				var m = od_cls._dsl_getattribute(name)
				if m != null and not (m is DSLNone):
					if m.has_method("__get__"):
						return m.__get__(self, od_cls)
					return m
		return super._dsl_getattribute(name)

	static var _type_class: DSLClass = null

## DSL 双端队列, 对应 Python collections.deque (P1-32) [br]
## 有界 maxlen 时溢出静默挤出一端; 不支持切片 (CPython 一致)
class DSLDeque extends DSLObject:
	## 队列元素
	var items: Array[DSLObject] = []
	## 容量上限 (-1 表示无界)
	var maxlen: int = -1
	## deque 类引用
	static var _type_class: DSLClass = null
	## magic 方法描述符缓存
	var _deque_magic_descriptors: Dictionary = {}

	## 构造双端队列 [br]
	## [param p_maxlen] 容量上限, -1 表示无界
	func _init(p_maxlen: int = -1):
		super._init()
		maxlen = p_maxlen

	func _type_name() -> String:
		return "collections.deque"

	## repr 对齐 CPython: deque([1, 2], maxlen=3), 无界时不带 maxlen 段; 子类带类名
	func magic_repr(_args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		if klass != null and klass.name != "deque":
			return DSLString.new(klass.name + "(" + _dsl_str().substr("deque".length() + 1))
		return DSLString.new(_dsl_str())

	## deque 本尊属性面无实例字典: maxlen 只读, 其余属性一律拒绝 (CPython 语义); [br]
	## 子类实例有 __dict__ (I1-73), 走基类 fields 写入
	func _dsl_setattr(name: String, value: DSLObject):
		if klass != null and klass != DSLDeque._type_class:
			super._dsl_setattr(name, value)
			return
		var cls = klass if klass != null else DSLDeque._type_class
		if cls != null:
			var method = cls._lookup_method("__setattr__")
			if method is DSLFunction:
				cls._invoke_func(method, [self, DSLString.new(name), value] as Array[DSLObject], {} as Dictionary[String, DSLObject])
				return
		if name == "maxlen":
			last_error = "AttributeError: attribute 'maxlen' of 'collections.deque' objects is not writable"
			return
		last_error = "AttributeError: 'collections.deque' object has no attribute '%s'" % name

	## append 时按 maxlen 挤出对侧元素
	func _push_back(v: DSLObject) -> void:
		items.append(v)
		if maxlen >= 0 and items.size() > maxlen:
			items.pop_front()

	func _push_front(v: DSLObject) -> void:
		items.insert(0, v)
		if maxlen >= 0 and items.size() > maxlen:
			items.pop_back()

	func _dsl_str() -> String:
		var inner = ""
		for i in range(items.size()):
			if i > 0:
				inner += ", "
			inner += DSLObject._py_repr(items[i])
		var out = "deque([" + inner + "]"
		if maxlen >= 0:
			out += ", maxlen=%d" % maxlen
		return out + ")"

	func _dsl_bool() -> bool:
		return items.size() > 0

	func _dsl_iter() -> DSLIterator:
		return DSLListIterator.new(items)

	func _dsl_eq(other: DSLObject) -> bool:
		var rhs = DSLObject._unwrap_dsl(other)
		if not (rhs is DSLDeque):
			return false
		if rhs.items.size() != items.size():
			return false
		for i in range(items.size()):
			if not _items_eq(items[i], rhs.items[i]):
				return false
		return true

	## 元素等值比较 (数值跨型相等)
	func _items_eq(a: DSLObject, b: DSLObject) -> bool:
		if a is DSLInteger and b is DSLInteger:
			return a.value == b.value
		if a is DSLFloat and b is DSLFloat:
			return a.value == b.value
		if a is DSLString and b is DSLString:
			return a.value == b.value
		return a == b

	func _dsl_getitem(index: DSLObject) -> DSLObject:
		if index is DSLSlice:
			last_error = "TypeError: sequence index must be integer, not 'slice'"
			return null
		if not (index is DSLInteger):
			last_error = "TypeError: deque indices must be integers, not '%s'" % index._type_name()
			return null
		var i = index.value
		if i < 0:
			i += items.size()
		if i < 0 or i >= items.size():
			last_error = "IndexError: deque index out of range"
			return null
		return items[i]

	## deque 下标赋值 (仅整数下标, CPython 不支持切片赋值)
	func _dsl_setitem(index: DSLObject, value: DSLObject):
		if index is DSLSlice:
			last_error = "TypeError: sequence index must be integer, not 'slice'"
			return
		if not (index is DSLInteger):
			last_error = "TypeError: deque indices must be integers, not '%s'" % index._type_name()
			return
		var i = index.value
		if i < 0:
			i += items.size()
		if i < 0 or i >= items.size():
			last_error = "IndexError: deque assignment index out of range"
			return
		items[i] = value

	func magic_len(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		return DSLInteger.pooled((args[0] as DSLDeque).items.size())

	func magic_eq(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLBool:
		return DSLBool.new((args[0] as DSLDeque)._dsl_eq(args[1]))

	func magic_ne(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLBool:
		return DSLBool.new(not (args[0] as DSLDeque)._dsl_eq(args[1]))

	func magic_contains(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLBool:
		var target = DSLObject._unwrap_dsl(args[1])
		for it in (args[0] as DSLDeque).items:
			if (args[0] as DSLDeque)._items_eq(it, target):
				return DSLBool.new(true)
		return DSLBool.new(false)

	## deque + deque: 新队列, maxlen 沿用左侧, 超限收敛保留末端 (CPython 语义)
	func magic_add(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0]
		var other = DSLObject._unwrap_dsl(args[1])
		if other is DSLDeque:
			var out = DSLDeque.new(self_obj.maxlen)
			out.items.append_array(self_obj.items)
			out.items.append_array((other as DSLDeque).items)
			if out.maxlen >= 0:
				while out.items.size() > out.maxlen:
					out.items.pop_front()
			return out
		self_obj.last_error = "TypeError: can only concatenate deque (not \"%s\") to deque" % other._type_name()
		return null

	## deque += iterable: extend 语义原位追加并返回自身 (CPython sq_inplace_add)
	func magic_iadd(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0]
		var other = DSLObject._unwrap_dsl(args[1])
		var it = other._dsl_iter()
		if it == null:
			self_obj.last_error = "TypeError: can only concatenate deque (not \"%s\") to deque" % other._type_name()
			return null
		while it.has_next():
			var item = it.next()
			if it.suspended:
				break
			self_obj._push_back(item)
		return self_obj

	## deque * n: 重复 n 次, maxlen 沿用左侧, 超限收敛保留末端 (CPython 语义)
	func magic_mul(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLObject:
		var self_obj = args[0]
		var other = DSLObject._unwrap_dsl(args[1])
		var reps = -1
		if other is DSLInteger:
			# 重复计数为索引位 (CPython Py_ssize_t 同构)
			if (other as DSLInteger).is_big():
				self_obj.last_error = "OverflowError: cannot fit 'int' into an index-sized integer"
				return null
			reps = other.value
		elif other is DSLBool:
			reps = 1 if other.value else 0
		else:
			self_obj.last_error = "TypeError: can't multiply sequence by non-int of type '%s'" % other._type_name()
			return null
		if reps < 0:
			reps = 0
		var out = DSLDeque.new(self_obj.maxlen)
		for _i in range(reps):
			out.items.append_array(self_obj.items)
		if out.maxlen >= 0:
			while out.items.size() > out.maxlen:
				out.items.pop_front()
		return out

	## 字典序比较: deque 只与 deque 比较, 跨类型按 CPython 报 TypeError (文案经 collections.deque)
	func magic_lt(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLBool:
		var self_obj = args[0]
		var other = DSLObject._unwrap_dsl(args[1])
		if other is DSLDeque:
			var c = DSLList._seq_lex_compare(self_obj.items, (other as DSLDeque).items, self_obj, "<")
			if c == -2:
				return DSLBool.new(false)
			return DSLBool.new(c < 0)
		self_obj._comparison_type_error("<", other)
		return DSLBool.new(false)

	func magic_gt(args: Array[DSLObject], _kwargs: Dictionary[String, DSLObject]) -> DSLBool:
